{
  "brand": "MonoKromatik",
  "version": "1.0",
  "color": {
    "ink": { "black": "#000000", "ink": "#141210", "charcoal": "#1A1A1A" },
    "amber": { "signal": "#CC5500", "strong": "#A85416", "hover": "#8F4612", "bright": "#E8631C" },
    "neutral": { "gray": "#666666", "grayBright": "#8A8A8A", "border": "#E5E5E5" },
    "surface": { "paper": "#FAF8F4", "softWhite": "#F5F5F5", "muted": "#F0F0F0", "white": "#FFFFFF" }
  },
  "type": {
    "display": { "family": "Space Grotesk", "use": "wordmark, headlines, labels, UI, data", "weights": [500, 700] },
    "feature": { "family": "Fraunces", "use": "standfirsts, pull-quotes, editorial", "styles": ["regular", "italic", "semibold"] },
    "body": { "family": "Inter", "use": "long-form, captions, fine print", "weights": [400, 500] },
    "label": { "family": "Space Grotesk", "weight": 700, "transform": "uppercase", "tracking": "0.25em" }
  },
  "ratio": "60 mono ground / 35 mono structure / 5 amber signal"
}
